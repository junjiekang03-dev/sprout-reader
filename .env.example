# 复制为 .env 后填写
DATABASE_URL="file:./dev.db"
SESSION_SECRET="改成随机长字符串"
ADMIN_KEY="内容审核台访问密钥(/admin?key=...)"

# TTS 预生成(留空则跳过,阅读器自动回退浏览器 Web Speech)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="swedencentral"   # 填你订阅实际允许的区域(学生订阅区域受策略限制)
MINIMAX_API_KEY=""
MINIMAX_GROUP_ID=""

# 朗读音色按「年龄段(级别)」在 scripts/tts-generate.ts 的 VOICE_BY_STAGE 配置
# (小学=童声 Ana;初中段待定),不在 .env 设置。
