# 复制为 .env 后填写
DATABASE_URL="file:./dev.db"
SESSION_SECRET="改成随机长字符串"
ADMIN_KEY="内容审核台访问密钥(/admin?key=...)"

# TTS 预生成(二选一,留空则跳过,阅读器自动回退浏览器 Web Speech)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastasia"
MINIMAX_API_KEY=""
MINIMAX_GROUP_ID=""

# 朗读音色与情感(可选,做 A/B;默认温暖友好的讲故事语气)
AZURE_TTS_VOICE="en-US-JennyNeural"
AZURE_TTS_STYLE="friendly"
AZURE_TTS_STYLEDEGREE="1.6"
