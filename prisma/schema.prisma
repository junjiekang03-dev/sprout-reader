// 数据模型
//
// 本地开发用 SQLite(零安装);部署时把 provider 换成 "postgresql" 即可。
// 注意:SQLite 不支持 Prisma 的 Json 标量,所以 glossary/questions/interests
// 统一用 String 存 JSON 文本,应用层解析——这样 schema 在两种库之间完全可移植。
//
// 合规设计(儿童个人信息保护):
//   - 注册主体是家长(Parent,手机号),孩子只作为子档案(Child)存在
//   - 孩子档案只收昵称/英文名,不收真实姓名、不收任何身份信息

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Parent {
  id           String    @id @default(cuid())
  phone        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  children     Child[]
  sessions     Session[]
}

model Session {
  token     String   @id
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Child {
  id            String    @id @default(cuid())
  parentId      String
  parent        Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  nickname      String // 仅昵称/英文名,故事名字槽位也用它
  levelId       Int       @default(1)
  interests     String    @default("[]") // JSON: InterestKey[]
  placementDone Boolean   @default(false)
  autoFollowLevel Boolean @default(false) // BACKLOG#3:开启后,命中升/降建议时自动调一级
  createdAt     DateTime  @default(now())
  readings      Reading[]
  wordbook      WordbookEntry[]
  levelChanges  LevelChange[]
  badges        ChildBadge[]
}

model Story {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  levelId       Int
  interest      String // 兴趣主题轨道 key
  wordCount     Int
  text          String // 正文;主角名用 {{name}} 槽位,渲染时替换为孩子英文名
  glossaryJson  String    @default("[]") // JSON: [{ word, zh }]
  questionsJson String // JSON: [{ prompt, options: string[], answer: number }]
  audioUrl      String? // 预生成 TTS 音频;为空时前端回退 Web Speech
  status        String    @default("published") // draft | published
  createdAt     DateTime  @default(now())
  readings      Reading[]
}

model Reading {
  id           String   @id @default(cuid())
  childId      String
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  storyId      String
  story        Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  dateKey      String // 本地日期 "2026-06-13",打卡与周报的聚合键
  correctCount Int
  totalCount   Int
  durationSec  Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([childId, storyId, dateKey])
  @@index([childId, dateKey])
}

// 生词本:孩子阅读中查过的词,进入 Leitner 间隔重复(见 src/lib/srs.ts)
model WordbookEntry {
  id           String   @id @default(cuid())
  childId      String
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  word         String // 归一化小写
  zh           String // 中文释义(查词时拿到的;无释义则空串)
  box          Int      @default(1) // Leitner 盒子 1-5
  dueDateKey   String // 下次复习日期 "2026-06-13"
  timesCorrect Int      @default(0)
  timesWrong   Int      @default(0)
  createdAt    DateTime @default(now())
  lastReviewedAt DateTime?

  @@unique([childId, word])
  @@index([childId, dueDateKey])
}

// 调级记录:自动跟随(或手动)产生的升/降级,可撤销(BACKLOG#3)
model LevelChange {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  fromLevel Int
  toLevel   Int
  direction String // up | down
  auto      Boolean  @default(true) // true=自动跟随触发;false=家长手动接受
  undone    Boolean  @default(false) // 撤销后置 true,并把级别还原回 fromLevel
  createdAt DateTime @default(now())

  @@index([childId, createdAt])
}

// 徽章(游戏化·成就感):一旦解锁即持久化,永不撤销(positive-only)。
// badgeKey 对应 src/lib/badges.ts 的徽章目录;按 (childId, badgeKey) 唯一,避免重复发放。
model ChildBadge {
  id       String   @id @default(cuid())
  childId  String
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  badgeKey String
  earnedAt DateTime @default(now())

  @@unique([childId, badgeKey])
  @@index([childId])
}
